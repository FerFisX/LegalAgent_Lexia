# ── Base de datos relacional ──────────────────────────────────────
POSTGRES_USER=lexia_user
POSTGRES_PASSWORD=lexia_pass
POSTGRES_DB=lexia_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j ─────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexia_neo4j_pass
NEO4J_URI=bolt://localhost:7687

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=lexia_legal_docs

# ── LLM ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Embeddings ────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu   # cambiar a "cuda" si tienes GPU

# ── Scraper ───────────────────────────────────────────────────────
GACETA_BASE_URL=https://gacetaoficial.bo
SCRAPER_DELAY_SECONDS=2
RAW_PDFS_PATH=data/raw_pdfs
PROCESSED_PATH=data/processed
CHECKPOINTS_PATH=data/checkpoints

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PATH=logs/lexia.log
